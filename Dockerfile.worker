FROM node:20-alpine AS base

FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json package-lock.json* ./
COPY prisma ./prisma/
RUN npm ci
RUN npx prisma generate

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

COPY --from=deps --chown=worker:nodejs /app/node_modules ./node_modules
COPY --chown=worker:nodejs package.json ./
COPY --chown=worker:nodejs prisma ./prisma
COPY --chown=worker:nodejs lib ./lib
COPY --chown=worker:nodejs data ./data
COPY --chown=worker:nodejs worker ./worker
COPY --chown=worker:nodejs tsconfig.json ./

USER worker

# No port: the worker long-polls SQS, nothing connects to it.
CMD ["npx", "tsx", "worker/index.ts"]
